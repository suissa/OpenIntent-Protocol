{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.org/schemas/discovery-query-1.0.0.json",
  "title": "OpenIntent Capability Discovery Query",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id"],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "min_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "required_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
