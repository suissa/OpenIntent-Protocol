{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.org/schemas/composition-1.0.0.json",
  "title": "OpenIntent Composition Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "graph_version", "max_nodes", "nodes"],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "max_nodes": {"type": "integer", "minimum": 1, "maximum": 1000},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent_id", "depends_on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "intent_id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "compensation_for": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
