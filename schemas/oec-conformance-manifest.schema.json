{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.org/schemas/oec-conformance-manifest-0.1.0.json",
  "title": "OEC Generated Conformance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "declaration_sha256", "generator", "cases"],
  "properties": {
    "profile": {"const": "oec-0.1.0"},
    "declaration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generator": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["happy", "missing-header", "method-mismatch", "path-mismatch", "body-mismatch", "stream-accept"]},
          "expected": {"type": "string"}
        }
      }
    }
  }
}
