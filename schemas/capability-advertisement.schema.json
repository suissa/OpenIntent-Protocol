{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.org/schemas/capability-advertisement-1.0.0.json",
  "title": "OpenIntent Capability Advertisement",
  "type": "object",
  "additionalProperties": false,
  "required": ["advertisement_id", "capability_id", "provider_id", "version", "schemas", "channels", "required_features", "priority", "expires_at"],
  "properties": {
    "advertisement_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schemas": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "channels": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "required_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "priority": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked": {"type": "boolean"}
  }
}
